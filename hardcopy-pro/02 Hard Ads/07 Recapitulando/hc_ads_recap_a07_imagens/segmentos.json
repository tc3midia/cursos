    {
      "start": 538.02,
      "end": 542.9399999999999,
      "text": " Para deixar ainda mais macabro essa parte aqui"
    },
    {
      "start": 542.9399999999999,
      "end": 546.42,
      "text": " A gente pode colocar uma tarja no olho dessa senhora"
    },
    {
      "start": 546.42,
      "end": 548.48,

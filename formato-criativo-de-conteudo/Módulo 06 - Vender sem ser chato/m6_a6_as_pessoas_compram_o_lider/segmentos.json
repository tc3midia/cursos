    {
      "start": 759.44,
      "end": 761.46,
      "text": " o nível de proximidade que você gera"
    },
    {
      "start": 761.46,
      "end": 762.82,
      "text": " com eles é muito alto, por quê?"
    },
    {
      "start": 763.2800000000001,
      "end": 764.5200000000001,
      "text": " porque, para pra pensar"
